extends SceneTree
var swaps := 0
func _initialize() -> void:
	call_deferred("_run")
func _run() -> void:
	var transition = load("res://scripts/PixteeShotTransition.gd").new()
	root.add_child(transition)
	transition.begin(func(): swaps += 1)
	transition.advance(0.99)
	assert(swaps == 0 and transition.busy and transition.cover.color.a == 0.0)
	transition.advance(0.34)
	assert(swaps == 1 and transition.swapped and transition.cover.color.a > 0.9)
	transition.advance(0.6)
	assert(swaps == 1 and not transition.busy and not transition.cover.visible)
	transition.begin(func(): swaps += 1)
	transition.advance(0.4)
	transition.finish_immediately()
	transition.finish_immediately()
	assert(swaps == 2 and not transition.busy)
	transition.begin(func(): swaps += 1)
	transition.cancel_discard()
	transition.advance(2.0)
	assert(swaps == 2)
	var profile = load("res://scripts/PixteePlayerProfile.gd").new()
	assert(profile.load_profile("user://tests/weather-"+str(Time.get_ticks_usec())))
	assert(profile.set_setting("weather_preset","rain"))
	assert(not profile.set_setting("weather_preset","invalid"))
	print("SHOT_TRANSITION_PASS: stopped view held one second, one hidden swap, pause/cancel safe; weather saved and validated")
	quit(0)
