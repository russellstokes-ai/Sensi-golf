extends SceneTree
var swaps := 0
func _initialize() -> void:
	call_deferred("_run")
func _run() -> void:
	var transition = load("res://scripts/PixteeShotTransition.gd").new()
	root.add_child(transition)
	transition.begin(func(): swaps += 1)
	transition.advance(0.99)
	assert(swaps == 0 and transition.busy and transition.cover.color.a == 0.0)
	transition.advance(0.34)
	assert(swaps == 1 and transition.swapped and transition.cover.color.a > 0.9)
	transition.advance(0.6)
	assert(swaps == 1 and not transition.busy and not transition.cover.visible)
	transition.begin(func(): swaps += 1)
	transition.advance(0.4)
	transition.finish_immediately()
	transition.finish_immediately()
	assert(swaps == 2 and not transition.busy)
	transition.begin(func(): swaps += 1)
	transition.cancel_discard()
	transition.advance(2.0)
	assert(swaps == 2)
	var scene = load("res://scenes/Lakewood.tscn").instantiate()
	root.add_child(scene)
	scene.set_process(false)
	scene.start_hole()
	var start: Vector2 = scene.world.golfer_world
	for shot in [[0,105,1946],[1,95,1942],[12,105,2121]]:
		scene.core.set_club_index(shot[0])
		scene.core.set_aim_raw(shot[2])
		scene.sync_attended_flag_for_native(scene.core)
		scene.core.meter_click_raw(0)
		scene.core.meter_click_raw(shot[1])
		scene.core.meter_click_raw(63)
		assert(scene.core.step_ticks(4096))
		scene.shot_was_active = true
		scene._process(0.0)
		assert(scene.shot_transition.busy and scene.world.golfer_world == start)
		scene._process(0.99)
		assert(scene.world.golfer_world == start and not scene.shot_transition.swapped)
		scene._process(0.34)
		assert(scene.shot_transition.swapped)
		start = scene.world.golfer_world
		scene._process(0.6)
		assert(not scene.shot_transition.busy)
	assert(not scene.playing and scene.core.snapshot().holes_completed == 1)
	scene.free()
	var profile = load("res://scripts/PixteePlayerProfile.gd").new()
	assert(profile.load_profile("user://tests/weather-"+str(Time.get_ticks_usec())))
	assert(profile.set_setting("weather_preset","rain"))
	assert(not profile.set_setting("weather_preset","invalid"))
	var director := PixteeWeatherDirector.new()
	root.add_child(director)
	director.set_preset("rain",2.0)
	director.reduced_motion = true
	var before := director.conditions()
	director._process(0.1)
	assert(director.conditions() == before)
	director.reduced_motion = false
	director._process(0.1)
	assert(director.conditions() != before)
	print("SHOT_TRANSITION_PASS: stopped view held one second, one hidden swap, pause/cancel safe; weather saved and validated")
	quit(0)
