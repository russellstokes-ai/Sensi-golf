<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:allowBackup="false" android:label="Pixtee Golf"
        android:usesCleartextTraffic="false" android:theme="@android:style/Theme.Material.NoActionBar"
        android:resizeableActivity="true">
        <activity android:name=".PixteeActivity" android:exported="true"
            android:screenOrientation="portrait" android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
