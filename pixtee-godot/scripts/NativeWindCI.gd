extends SceneTree
func _initialize() -> void:
	call_deferred("_run")
func _run() -> void:
	var scene = load("res://scenes/Lakewood.tscn").instantiate()
	root.add_child(scene)
	scene.set_process(false)
	assert(scene.profile.load_profile("user://tests/wind-"+str(Time.get_ticks_usec())))
	scene.start_hole(false,true)
	assert(scene.core.snapshot().wind_enabled and scene.core.snapshot().wind_speed_mph_x10 == 60)
	assert(scene.club_card.state.wind_speed_mph_x10 == 60)
	assert(scene.club_card.wind_direction().x > 0 and scene.club_card.wind_direction().y < 0)
	scene.pause_game()
	var paused := scene.core.save_native_session()
	assert(scene.profile.set_setting("wind_speed_mph_x10",120))
	scene.apply_saved_settings()
	scene._process(0.2)
	assert(scene.core.save_native_session() == paused)
	assert(scene.core.snapshot().wind_speed_mph_x10 == 60)
	scene.resume_game()
	var calm: PixteeRoundBridge = scene.create_course_core(0,false)
	for core in [scene.core,calm]:
		core.set_aim_raw(2048)
		core.meter_click_raw(0)
		core.meter_click_raw(105)
		core.meter_click_raw(63)
		for tick in range(25): core.step_tick()
	assert(scene.core.snapshot().ball_x_raw > calm.snapshot().ball_x_raw)
	var restore: PixteeRoundBridge = scene.create_course_core(0,false)
	assert(restore.restore_native_session(scene.core.save_native_session()))
	assert(restore.save_native_session() == scene.core.save_native_session())
	for tick in range(20):
		scene.core.step_tick()
		restore.step_tick()
		assert(restore.save_native_session() == scene.core.save_native_session())
	assert(not scene.core.set_authored_wind(0,80,true))
	print("NATIVE_WIND_PASS: shared HUD/ball direction, next-round settings, pause and exact midflight replay")
	scene.free()
	await create_timer(0.5).timeout
	quit(0)
