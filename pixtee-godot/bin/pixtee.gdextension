[configuration]
entry_symbol = "pixtee_library_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://bin/libpixtee_gameplay.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libpixtee_gameplay.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libpixtee_gameplay.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libpixtee_gameplay.windows.template_release.x86_64.dll"
android.debug.arm64 = "res://bin/libpixtee_gameplay.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/libpixtee_gameplay.android.template_release.arm64.so"
android.debug.x86_64 = "res://bin/libpixtee_gameplay.android.template_debug.x86_64.so"
android.release.x86_64 = "res://bin/libpixtee_gameplay.android.template_release.x86_64.so"
